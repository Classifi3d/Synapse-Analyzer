# Synapse API. Must include the /api prefix; the backend routes are /api/analysis/...
VITE_API_BASE_URL=http://localhost:5056/api

# Cerberus SSO. Origin only - no trailing slash and no path.
# The http profile is used rather than https://localhost:7077 so the browser is not
# blocked by the ASP.NET development certificate.
VITE_SSO_BASE_URL=http://localhost:5211

# Must match a client registered through POST /OAuth/clients on Cerberus, and its
# RedirectUri must equal VITE_SSO_REDIRECT_URI byte for byte.
VITE_SSO_CLIENT_ID=synapse-spa
VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_SSO_SCOPE=openid profile email
