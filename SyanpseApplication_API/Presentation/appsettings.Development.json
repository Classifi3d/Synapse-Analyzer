{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Application.Services": "Debug",
      "Infrastructure.ExternalServices": "Debug"
    }
  },
  "Jwt": {
    // Local development validates tokens against this symmetric key instead of an SSO
    // authority. Set Jwt:Authority and clear this key once the identity provider is wired up.
    "SigningKey": "development-only-signing-key-change-me-at-least-32-bytes",
    "Issuer": "synapse",
    "Audience": "synapse-api"
  }
}
