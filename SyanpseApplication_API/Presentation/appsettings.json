{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Server=localhost:5432;User ID=postgres;Password=password;Database=SynapseAnalyzerDB;Include Error Detail=true;"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Authority": "",
    "Audience": "synapse-api",
    "Issuer": "synapse",
    "SigningKey": ""
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "synapse-pcap-uploads",
    "Region": "us-east-1",
    "PartSizeBytes": 67108864,
    "CreateBucketIfMissing": true
  },
  "Zeek": {
    "BaseAddress": "http://localhost:8000",
    "Timeout": "00:30:00"
  },
  "Ollama": {
    "BaseAddress": "http://localhost:11434",
    "Model": "llama3.1",
    "ContextLength": 8192,
    "Temperature": 0.2,
    "Timeout": "00:15:00"
  },
  "Analysis": {
    "MaxFileSizeBytes": 10737418240,
    "UploadUrlLifetime": "06:00:00",
    "DownloadUrlLifetime": "02:00:00",
    "PromptRowsPerLog": 40,
    "AllowedExtensions": [ ".pcap", ".pcapng", ".cap" ]
  }
}
